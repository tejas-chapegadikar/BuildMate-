NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used in notification email links. Set to your real domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — email notifications (new applicant / accepted) are skipped
# gracefully if this is unset. Get a key at resend.com.
RESEND_API_KEY=

# Optional — raises the GitHub API rate limit used by /u/[username] from 60
# req/hr (unauthenticated, shared across all visitors) to 5,000 req/hr. A
# "public repo" read-only classic token is enough — generate one at
# github.com/settings/tokens. Falls back to unauthenticated requests if unset.
GITHUB_TOKEN=
